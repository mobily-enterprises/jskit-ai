{
  "name": "@jskit-ai/jskit-catalog",
  "version": "0.1.256",
  "description": "Published metadata catalog for JSKIT package metadata.",
  "type": "module",
  "files": [
    "catalog",
    "scripts"
  ],
  "bin": {
    "jskit": "scripts/jskit.mjs"
  },
  "exports": {
    ".": "./catalog/packages.json",
    "./packages": "./catalog/packages.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "catalog:build": "node ./scripts/build-catalog.mjs",
    "jskit:check": "node ./scripts/jskit.mjs check",
    "verify:packages": "node ./scripts/verify-packages.mjs",
    "test": "node --test --test-concurrency=1"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "jskit",
    "catalog",
    "metadata",
    "descriptors"
  ]
}
