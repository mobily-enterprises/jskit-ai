{
  "name": "@jskit-ai/release",
  "version": "0.1.1",
  "description": "Selective npm release preparation, publication and dependency pinning for package repositories.",
  "type": "module",
  "files": [
    "bin",
    "src"
  ],
  "bin": {
    "jskit-release": "bin/jskit-release.mjs"
  },
  "exports": {
    ".": "./src/release.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "tar": "7.5.22"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mobily-enterprises/jskit-ai.git",
    "directory": "tooling/jskit-release"
  },
  "bugs": {
    "url": "https://github.com/mobily-enterprises/jskit-ai/issues"
  },
  "homepage": "https://github.com/mobily-enterprises/jskit-ai/tree/main/tooling/jskit-release#readme",
  "keywords": [
    "jskit",
    "release",
    "npm",
    "publish"
  ]
}
