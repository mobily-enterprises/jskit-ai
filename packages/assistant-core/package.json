{
  "name": "@jskit-ai/assistant-core",
  "version": "0.1.178",
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    "./client": "./src/client/index.js",
    "./server": "./src/server/index.js",
    "./shared": "./src/shared/index.js",
    "./client/conversation": "./src/client/conversation/index.js",
    "./server/codex-events": "./src/server/conversation/codexEvents.js",
    "./server/codex-turn": "./src/server/conversation/codexTurn.js",
    "./server/codex-client": "./src/server/conversation/codexClient.js",
    "./server/opencode-client": "./src/server/conversation/openCodeClient.js",
    "./server/conversation": "./src/server/conversation/index.js",
    "./shared/conversation": "./src/shared/conversation/index.js",
    "./client/conversation-submit": "./src/client/conversation/submitText.js",
    "./client/conversation-scroll": "./src/client/conversation/useScrollToBottom.js",
    "./testing/conversation-storage": "./src/testing/conversationStorageContract.js",
    "./client/conversation-suggestions": "./src/client/conversation/useAssistantSuggestions.js",
    "./client/conversation-attachments": "./src/client/conversation/useAssistantAttachments.js",
    "./client/conversation-delivery": "./src/client/conversation/messageDelivery.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/cerebras": "^3.0.48",
    "@ai-sdk/google": "^4.0.70",
    "@ai-sdk/groq": "^4.0.41",
    "@ai-sdk/mistral": "^4.0.43",
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@ai-sdk/perplexity": "^4.0.43",
    "@ai-sdk/togetherai": "^3.0.49",
    "@ai-sdk/xai": "^4.0.58",
    "@jskit-ai/resource-core": "0.1.142",
    "@jskit-ai/resource-crud-core": "0.1.142",
    "@mdi/js": "^7.4.47",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.101",
    "json-rest-schema": "^1.0.17",
    "openai": "^6.22.0",
    "ws": "^8.20.1"
  },
  "peerDependencies": {
    "@jskit-ai/http-runtime": "0.1.198",
    "@jskit-ai/kernel": "0.1.200",
    "vue": "^3.5.13",
    "vuetify": "^4.0.0"
  },
  "description": "Reusable assistant client/server/shared primitives without surface-specific routes or settings ownership.",
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "assistant.core"
      ],
      "requires": []
    },
    "runtime": {
      "server": {
        "providers": []
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./client",
            "summary": "Exports reusable assistant UI primitives, HTTP helpers, and client API builders."
          },
          {
            "subpath": "./server",
            "summary": "Exports reusable assistant AI/provider and NDJSON streaming helpers."
          },
          {
            "subpath": "./shared",
            "summary": "Exports reusable assistant validators, path helpers, query keys, and stream/settings events."
          },
          {
            "subpath": "./client/conversation",
            "summary": "Embeddable conversation element, transcript, composer and progress presentation with application-owned state and actions."
          },
          {
            "subpath": "./server/conversation",
            "summary": "Conversation transcript lifecycle with replaceable application storage and an explicit transient memory adapter."
          },
          {
            "subpath": "./shared/conversation",
            "summary": "Turn mapping, rich-text parsing, question helpers and scroll-follow state."
          },
          {
            "subpath": "./server/codex-client",
            "summary": "Codex app-server JSON-RPC client; the application supplies the endpoint, identity and request authorization."
          },
          {
            "subpath": "./server/codex-turn",
            "summary": "Native Codex detached-turn observation and final-result recovery."
          },
          {
            "subpath": "./server/codex-events",
            "summary": "Native Codex notification and thread-history classification."
          },
          {
            "subpath": "./server/opencode-client",
            "summary": "Bounded OpenCode loopback HTTP and SSE client."
          },
          {
            "subpath": "./client/conversation-submit",
            "summary": "Companion text submission through the application draft and canonical send action."
          },
          {
            "subpath": "./client/conversation-scroll",
            "summary": "Layout-aware scroll-follow operations."
          },
          {
            "subpath": "./testing/conversation-storage",
            "summary": "Reusable checks for application conversation storage adapters."
          },
          {
            "subpath": "./client/conversation-delivery",
            "summary": "Optimistic message delivery, immutable retry payloads, failure actions and canonical receipt reconciliation."
          }
        ],
        "capabilities": []
      }
    }
  }
}
