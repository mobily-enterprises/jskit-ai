    "./server/crudContracts": "./src/server/crudContracts.js",
    "./server/defineCrudFeature": "./src/server/defineCrudFeature.js",
    "./server/listQueryValidators": "./src/server/listQueryValidators.js",
    "./server/listFilters": "./src/server/listFilters.js",
    "./server/routeContracts": "./src/server/routeContracts.js",
    "./server/types": "./src/server/types.js",
    "./locales/en.json": "./locales/en.json"
  },
  "dependencies": {
    "@jskit-ai/resource-core": "0.1.206",
    "@jskit-ai/resource-crud-core": "0.1.206",
