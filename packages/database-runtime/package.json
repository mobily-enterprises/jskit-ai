{
  "name": "@jskit-ai/database-runtime",
  "version": "0.1.259",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1"
  },
  "exports": {
    "./server/providers/DatabaseProvider": "./src/server/providers/DatabaseProvider.js",
    "./server/databaseSetup": "./src/server/databaseSetup.js",
    "./server/knexMigrationConfig": "./src/server/knexMigrationConfig.js",
    "./server/foreignKeyMigrations": "./src/server/foreignKeyMigrations.js",
    "./server/types": "./src/server/types.js",
    "./shared": "./src/shared/index.js",
    "./shared/dateUtils": "./src/shared/dateUtils.js",
    "./shared/databaseClient": "./src/shared/databaseClient.js",
    "./shared/dialect": "./src/shared/dialect.js",
    "./shared/duplicateEntry": "./src/shared/duplicateEntry.js",
    "./shared/repositoryOptions": "./src/shared/repositoryOptions.js",
    "./shared/visibility": "./src/shared/visibility.js"
  },
  "dependencies": {
    "knex": "^3.1.0"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "runtime.database"
      ],
      "requires": [
        "runtime.database.driver",
        "runtime.env"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/providers/DatabaseProvider.js",
            "export": "DatabaseProvider"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/providers/DatabaseProvider",
            "summary": "Provides the runtime.database capability: the selected driver, its Knex client and a transaction manager."
          },
          {
            "subpath": "./server/databaseSetup",
            "summary": "Migrates the installed package graph and runs one explicit app-owned seed operation without a CLI or persistent setup record."
          },
          {
            "subpath": "./server/knexMigrationConfig",
            "summary": "Builds fixed-dialect Knex migration configuration and discovers immutable migrations directly from installed JSKIT packages."
          },
          {
            "subpath": "./server/foreignKeyMigrations",
            "summary": "Adds a single-column foreign key only when it is missing, refusing rows without a parent, for constraints migrations on fresh and already-migrated databases."
          },
          {
            "subpath": "./shared",
            "summary": "Exports shared repository helpers (transactions, record ids, JSON columns, visibility, duplicate-entry detection and date/time serialization)."
          },
          {
            "subpath": "./server/types",
            "summary": "Types of the runtime.database capability and of the runtime.database.driver contract every driver package implements, for features that require them."
          }
        ]
      }
    }
  },
  "peerDependencies": {
    "@jskit-ai/kernel": "0.2.10"
  }
}
