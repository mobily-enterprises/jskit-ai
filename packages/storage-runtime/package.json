{
  "name": "@jskit-ai/storage-runtime",
  "version": "0.1.168",
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    "./client": "./src/client/index.js",
    "./server/providers/StorageProvider": "./src/server/providers/StorageProvider.js"
  },
  "dependencies": {
    "unstorage": "^1.17.5"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "runtime.storage"
      ],
      "requires": [
        "runtime.app-root"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/providers/StorageProvider.js",
            "export": "StorageProvider"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/providers/StorageProvider",
            "summary": "Provides the configured runtime.storage instance."
          },
          {
            "subpath": "./client",
            "summary": "Exports no client runtime API today (reserved client entrypoint)."
          }
        ]
      }
    }
  },
  "peerDependencies": {
    "@jskit-ai/kernel": "0.1.171"
  }
}
