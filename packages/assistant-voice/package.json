{
  "name": "@jskit-ai/assistant-voice",
  "version": "0.2.40",
  "type": "module",
  "description": "Duplex voice conversations with application-owned targets, authorization and speech services.",
  "scripts": {
    "test": "jskit test"
  },
  "exports": {
    "./client": "./src/client/index.js",
    "./server": "./src/server/index.js",
    "./shared/protocol": "./src/shared/protocol.js",
    "./shared/visemes": "./src/shared/visemes.js",
    "./locales/en.json": "./locales/en.json"
  },
  "files": [
    "src",
    "locales",
    "README.md",
    "examples"
  ],
  "dependencies": {
    "@jskit-ai/assistant-core": "0.2.38",
    "ws": "^8.20.1"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [],
      "requires": []
    },
    "runtime": {
      "client": {
        "providers": []
      },
      "server": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./client",
            "summary": "One application voice controller and Vue modal, with push-to-talk, hands-free capture, playback, review and avatar presentation."
          },
          {
            "subpath": "./server",
            "summary": "Authorized WebSocket proxy, bounded speech daemon, access tokens and service configuration."
          },
          {
            "subpath": "./shared/protocol",
            "summary": "Voice control validation, PCM frame limits and streamed speech text segmentation."
          },
          {
            "subpath": "./shared/visemes",
            "summary": "Shared mouth poses and pronunciation timing for voice avatars."
          }
        ],
        "capabilities": []
      }
    }
  },
  "peerDependencies": {
    "@jskit-ai/kernel": "0.2.18",
    "vue": "^3.5.13",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@fastify/websocket": "^11.3.2"
  }
}
