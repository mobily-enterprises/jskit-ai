{
  "name": "@jskit-ai/workspaces-core",
  "version": "0.2.15",
  "type": "module",
  "scripts": {
    "test": "jskit test"
  },
  "exports": {
    "./server/WorkspacesFeature": "./src/server/WorkspacesFeature.js",
    "./server/WorkspacesIntegrationsProvider": "./src/server/WorkspacesIntegrationsProvider.js",
    "./server/validators/routeParamsValidator": "./src/server/common/validators/routeParamsValidator.js",
    "./server/support/workspaceRouteInput": "./src/server/support/workspaceRouteInput.js",
    "./server/support/workspaceCrud": "./src/server/support/workspaceCrud.js",
    "./server/support/workspaceRoutePaths": "./src/server/support/workspaceRoutePaths.js",
    "./server/types": "./src/server/types.js",
    "./shared/jsonApiTransports": "./src/shared/jsonApiTransports.js",
    "./shared/settings": "./src/shared/settings.js",
    "./shared/tenancyProfile": "./src/shared/tenancyProfile.js",
    "./shared/support/workspacePathModel": "./src/shared/support/workspacePathModel.js",
    "./shared/resources/workspaceResource": "./src/shared/resources/workspaceResource.js",
    "./shared/resources/workspaceSettingsResource": "./src/shared/resources/workspaceSettingsResource.js",
    "./locales/en.json": "./locales/en.json"
  },
  "dependencies": {
    "@jskit-ai/database-runtime": "0.1.262",
    "@jskit-ai/json-rest-api-core": "0.2.14",
    "@jskit-ai/resource-core": "0.1.204",
    "@jskit-ai/resource-crud-core": "0.1.204",
    "@jskit-ai/users-core": "0.2.15",
    "json-rest-schema": "^1.0.17"
  },
  "description": "Workspace tenancy runtime plus HTTP routes, role catalog, and workspace config scaffolding.",
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "workspaces.core",
        "workspaces",
        "workspaces.memberships"
      ],
      "requires": [
        "auth.extensions",
        "runtime.actions",
        "runtime.app-root",
        "runtime.bootstrap",
        "runtime.config",
        "runtime.database",
        "runtime.env",
        "runtime.http",
        "runtime.json-rest-api",
        "users.extensions",
        "users.profiles",
        "users.settings"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/WorkspacesFeature.js",
            "export": "WorkspacesFeature"
          },
          {
            "entrypoint": "src/server/WorkspacesIntegrationsProvider.js",
            "export": "WorkspacesIntegrationsProvider"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "jskit": {
        "tableOwnership": {
          "tables": [
            {
              "tableName": "workspaces"
            },
            {
              "tableName": "workspace_memberships"
            },
            {
              "tableName": "workspace_settings"
            },
            {
              "tableName": "workspace_invites"
            }
          ]
        }
      },
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/WorkspacesFeature",
            "summary": "Exports WorkspacesFeature, which provides workspaces.core (directory, members, pending invitations and settings services, their actions and routes), workspaces (the workspaces' records, with findBySlug and lock) and workspaces.memberships (the memberships' records, with addMember and activeMemberIds), and the optional tokens' defaults."
          },
          {
            "subpath": "./server/WorkspacesIntegrationsProvider",
            "summary": "Exports WorkspacesIntegrationsProvider, which adds workspace context, visibility, provisioning, realtime audiences and invitation context to auth, users and actions."
          },
          {
            "subpath": "./server/validators/routeParamsValidator",
            "summary": "Exports the workspaceSlug route params validator."
          },
          {
            "subpath": "./server/support/workspaceRouteInput",
            "summary": "Exports the action input a workspace route's params give, and requestedWorkspaceScope, the workspace a request asks for before the workspace context exists."
          },
          {
            "subpath": "./server/support/workspaceCrud",
            "summary": "Exports WORKSPACE_CRUD_SCOPE, the workspace scope of CRUD resources."
          },
          {
            "subpath": "./server/support/workspaceRoutePaths",
            "summary": "Exports the workspace route base path and resolveWorkspaceRoutePath."
          },
          {
            "subpath": "./server/types",
            "summary": "Types of the workspaces.core, workspaces and workspaces.memberships capabilities, for features that require them."
          }
        ],
        "capabilities": [
          "workspaces.core",
          "workspaces",
          "workspaces.memberships"
        ]
      },
      "server": {
        "routes": [
          {
            "method": "POST",
            "path": "/api/workspaces",
            "summary": "Create a workspace for the authenticated user."
          },
          {
            "method": "GET",
            "path": "/api/workspaces",
            "summary": "List workspaces visible to authenticated user."
          },
          {
            "method": "GET",
            "path": "/api/workspace/invitations/resolve",
            "summary": "Resolve safe public workspace invitation metadata."
          },
          {
            "method": "GET",
            "path": "/api/workspace/invitations/pending",
            "summary": "List pending workspace invitations for authenticated user."
          },
          {
            "method": "POST",
            "path": "/api/workspace/invitations/redeem",
            "summary": "Accept or refuse a workspace invitation using an invite token."
          },
          {
            "method": "GET",
            "path": "/api/w/:workspaceSlug/settings",
            "summary": "Get workspace settings and role catalog by workspace slug."
          },
          {
            "method": "PATCH",
            "path": "/api/w/:workspaceSlug/settings",
            "summary": "Update workspace settings by workspace slug."
          },
          {
            "method": "GET",
            "path": "/api/w/:workspaceSlug/roles",
            "summary": "Get role catalog by workspace slug."
          },
          {
            "method": "GET",
            "path": "/api/w/:workspaceSlug/members",
            "summary": "List members by workspace slug."
          },
          {
            "method": "PATCH",
            "path": "/api/w/:workspaceSlug/members/:memberUserId/role",
            "summary": "Update workspace member role by workspace slug."
          },
          {
            "method": "GET",
            "path": "/api/w/:workspaceSlug/invites",
            "summary": "List workspace invites by workspace slug."
          },
          {
            "method": "POST",
            "path": "/api/w/:workspaceSlug/invites",
            "summary": "Create workspace invite by workspace slug."
          },
          {
            "method": "DELETE",
            "path": "/api/w/:workspaceSlug/invites/:inviteId",
            "summary": "Revoke workspace invite by workspace slug."
          }
        ]
      }
    },
    "migrations": {
      "directories": [
        "migrations"
      ]
    }
  },
  "peerDependencies": {
    "@jskit-ai/auth-core": "0.2.13",
    "@jskit-ai/http-runtime": "0.2.13",
    "@jskit-ai/kernel": "0.2.13"
  }
}
