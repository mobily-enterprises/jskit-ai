{
  "name": "@jskit-ai/auth-core",
  "version": "0.1.168",
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    "./server/providers/AuthAccessProvider": "./src/server/providers/AuthAccessProvider.js",
    "./server/providers/AuthExtensionsProvider": "./src/server/providers/AuthExtensionsProvider.js",
    "./server/providers/AuthFeature": "./src/server/providers/AuthFeature.js",
    "./server/providers/AuthPolicyProvider": "./src/server/providers/AuthPolicyProvider.js",
    "./server/actions/auth.contributor": "./src/server/actions/auth.contributor.js",
    "./server/authExtensions": "./src/server/authExtensions.js",
    "./server/authPolicyContextResolverRegistry": "./src/server/authPolicyContextResolverRegistry.js",
    "./server/authServiceDecoratorRegistry": "./src/server/authServiceDecoratorRegistry.js",
    "./server/authActor": "./src/server/authActor.js",
    "./server/booleanFlag": "./src/server/booleanFlag.js",
    "./server/devAuth": "./src/server/devAuth.js",
    "./server/deferredAuthService": "./src/server/deferredAuthService.js",
    "./server/unsupportedOperation": "./src/server/unsupportedOperation.js",
    "./server/utils": "./src/server/utils.js",
    "./server/validators": "./src/server/validators.js",
    "./server/inviteTokens": "./src/server/inviteTokens.js",
    "./server/membershipAccess": "./src/server/membershipAccess.js",
    "./server/lib/index": "./src/server/lib/index.js",
    "./server/lib/plugin": "./src/server/lib/plugin.js",
    "./server/lib/routeMeta": "./src/server/lib/routeMeta.js",
    "./client": "./src/client/index.js",
    "./client/authApi": "./src/client/authApi.js",
    "./client/signOutFlow": "./src/client/signOutFlow.js",
    "./shared": "./src/shared/index.js",
    "./shared/authApi": "./src/shared/authApi.js",
    "./shared/signOutFlow": "./src/shared/signOutFlow.js",
    "./shared/authDenied": "./src/shared/authDenied.js",
    "./shared/authPaths": "./src/shared/authPaths.js",
    "./shared/authConstraints": "./src/shared/authConstraints.js",
    "./shared/authCapabilities": "./src/shared/authCapabilities.js",
    "./shared/authSecurityStatus": "./src/shared/authSecurityStatus.js",
    "./shared/authMethods": "./src/shared/authMethods.js",
    "./shared/oauthProviders": "./src/shared/oauthProviders.js",
    "./shared/oauthCallbackParams": "./src/shared/oauthCallbackParams.js",
    "./shared/inputNormalization": "./src/shared/inputNormalization.js",
    "./shared/inviteTokens": "./src/shared/inviteTokens.js",
    "./shared/commands": "./src/shared/commands/index.js",
    "./shared/commands/authRegisterCommand": "./src/shared/commands/authRegisterCommand.js",
    "./shared/commands/authRegisterConfirmationResendCommand": "./src/shared/commands/authRegisterConfirmationResendCommand.js",
    "./shared/commands/authLoginPasswordCommand": "./src/shared/commands/authLoginPasswordCommand.js",
    "./shared/commands/authLoginOtpRequestCommand": "./src/shared/commands/authLoginOtpRequestCommand.js",
    "./shared/commands/authLoginOtpVerifyCommand": "./src/shared/commands/authLoginOtpVerifyCommand.js",
    "./shared/commands/authLoginOAuthStartCommand": "./src/shared/commands/authLoginOAuthStartCommand.js",
    "./shared/commands/authLoginOAuthCompleteCommand": "./src/shared/commands/authLoginOAuthCompleteCommand.js",
    "./shared/commands/authDevLoginAsCommand": "./src/shared/commands/authDevLoginAsCommand.js",
    "./shared/commands/authPasswordResetRequestCommand": "./src/shared/commands/authPasswordResetRequestCommand.js",
    "./shared/commands/authPasswordRecoveryCompleteCommand": "./src/shared/commands/authPasswordRecoveryCompleteCommand.js",
    "./shared/commands/authPasswordResetCommand": "./src/shared/commands/authPasswordResetCommand.js",
    "./shared/commands/authLogoutCommand": "./src/shared/commands/authLogoutCommand.js",
    "./shared/commands/authSessionReadCommand": "./src/shared/commands/authSessionReadCommand.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "json-rest-schema": "^1.0.17"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "auth.access",
        "auth.extensions",
        "auth.policy"
      ],
      "requires": [
        "runtime.actions",
        "runtime.env",
        "runtime.fastify",
        "runtime.http"
      ]
    },
    "runtime": {
      "server": {
        "providerEntrypoint": "src/server/providers/AuthAccessProvider.js",
        "providers": [
          {
            "entrypoint": "src/server/providers/AuthAccessProvider.js",
            "export": "AuthAccessProvider"
          },
          {
            "entrypoint": "src/server/providers/AuthExtensionsProvider.js",
            "export": "AuthExtensionsProvider"
          },
          {
            "entrypoint": "src/server/providers/AuthFeature.js",
            "export": "AuthFeature"
          },
          {
            "entrypoint": "src/server/providers/AuthPolicyProvider.js",
            "export": "AuthPolicyProvider"
          }
        ]
      },
      "client": {
        "providers": [
          {
            "entrypoint": "src/client/providers/AccessCoreClientProvider.js",
            "export": "AccessCoreClientProvider"
          }
        ]
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./client",
            "summary": "Exports the client auth access API and its capability provider."
          },
          {
            "subpath": "./server",
            "summary": "Exports server auth access, shared auth action, and Fastify auth policy providers plus server auth utility modules."
          },
          {
            "subpath": "./shared",
            "summary": "Exports shared auth client helpers (createApi and runAuthSignOutFlow), with structured subpaths at ./shared/authApi and ./shared/signOutFlow."
          }
        ],
        "clientCapabilities": [
          "auth.access.client"
        ]
      },
      "client": {
        "singleton": true
      }
    }
  },
  "peerDependencies": {
    "@jskit-ai/kernel": "0.1.170"
  }
}
