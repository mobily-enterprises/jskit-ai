{
  "name": "@jskit-ai/auth-provider-oidc-core",
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1"
  },
  "exports": {
    "./server/providers/AuthOidcProvider": "./src/server/providers/AuthOidcProvider.js",
    "./server/lib/index": "./src/server/lib/index.js",
    "./shared": "./src/shared/index.js",
    "./locales/en.json": "./locales/en.json"
  },
  "bin": {
    "jskit-oidc-sign-in": "./bin/jskit-oidc-sign-in.js"
  },
  "dependencies": {
    "jose": "6.2.12",
    "knex": "^3.1.0",
    "openid-client": "6.8.8"
  },
  "devDependencies": {
    "@jskit-ai/auth-provider-local-core": "0.1.149",
    "@jskit-ai/auth-web": "0.1.251",
    "oidc-provider": "9.12.2"
  },
  "description": "Sign in through any OpenID Connect issuer: self-registration or a static client, app-owned sessions, and back-channel logout.",
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "auth.service"
      ],
      "requires": [
        "auth.extensions",
        "runtime.app-root",
        "runtime.database",
        "runtime.env",
        "runtime.fastify",
        "runtime.logger"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/providers/AuthOidcProvider.js",
            "export": "AuthOidcProvider"
          }
        ]
      }
    },
    "metadata": {
      "jskit": {
        "tableOwnership": {
          "tables": [
            {
              "tableName": "auth_oidc_clients"
            },
            {
              "tableName": "auth_oidc_sessions"
            },
            {
              "tableName": "auth_oidc_logout_tokens"
            }
          ]
        }
      },
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/providers/AuthOidcProvider",
            "summary": "Provides the OpenID Connect sign-in service and its back-channel and everywhere-logout routes."
          },
          {
            "subpath": "./server/lib/index",
            "summary": "Exports the OIDC auth service factory, configuration reader, and the local-account export and adopt commands."
          },
          {
            "subpath": "./shared",
            "summary": "Exports the provider id, redirect path and route paths apps and issuers register."
          }
        ],
        "capability": "auth.service"
      }
    },
    "migrations": {
      "directories": [
        "migrations"
      ]
    }
  },
  "peerDependencies": {
    "@jskit-ai/auth-core": "0.1.246",
    "@jskit-ai/kernel": "0.1.248"
  }
}
