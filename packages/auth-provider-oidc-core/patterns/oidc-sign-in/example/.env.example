# The accounts hub (or any OpenID Connect issuer). Discovery is used.
AUTH_OIDC_ISSUER=https://accounts.example.com/oidc
# Preferred: the app registers itself, once per address, with this token.
AUTH_OIDC_REGISTRATION_TOKEN=replace-me
# Instead of the token, for issuers without self-registration:
# AUTH_OIDC_CLIENT_ID=replace-me
# AUTH_OIDC_CLIENT_SECRET=replace-me
# Optional button label.
# AUTH_OIDC_LABEL=Continue with your account
# Required in production, at least 32 characters. Generated in development.
# AUTH_OIDC_SESSION_SECRET=replace-me
# The address people use. Registers at start; required behind a non-loopback proxy.
APP_PUBLIC_URL=http://localhost:5173
