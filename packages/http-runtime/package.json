{
  "name": "@jskit-ai/http-runtime",
  "version": "0.2.3",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1"
  },
  "exports": {
    "./client": "./src/client/index.js",
    "./shared": "./src/shared/index.js",
    "./shared/validators/errorResponses": "./src/shared/validators/errorResponses.js",
    "./shared/validators/jsonApiResult": "./src/shared/validators/jsonApiResult.js",
    "./shared/validators/jsonApiRouteTransport": "./src/shared/validators/jsonApiRouteTransport.js",
    "./shared/validators/operationValidation": "./src/shared/validators/operationValidation.js",
    "./locales/en.json": "./locales/en.json"
  },
  "dependencies": {
    "json-rest-schema": "^1.0.17"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [],
      "requires": []
    },
    "runtime": {
      "server": {
        "providers": []
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./client",
            "summary": "Exports HTTP client runtime APIs (createHttpClient, createTransientRetryHttpClient and transport helpers)."
          },
          {
            "subpath": "./shared",
            "summary": "Exports HTTP validator/schema utilities, with structured validator subpaths under ./shared/validators/*."
          }
        ]
      },
      "client": {
        "singleton": true
      }
    }
  },
  "peerDependencies": {
    "@jskit-ai/kernel": "0.2.3"
  }
}
