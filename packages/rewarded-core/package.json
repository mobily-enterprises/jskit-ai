{
  "name": "@jskit-ai/rewarded-core",
  "version": "0.2.39",
  "type": "module",
  "scripts": {
    "test": "jskit test"
  },
  "exports": {
    "./shared": "./src/shared/index.js",
    "./server/rewardedActions": "./src/server/rewardedActions.js",
    "./server/requireRewardedUnlock": "./src/server/support/requireRewardedUnlock.js",
    "./server/types": "./src/server/types.js",
    "./locales/en.json": "./locales/en.json"
  },
  "description": "Rewarded workflow runtime plus internal CRUD providers for rules, provider configs, watch sessions, and unlock receipts.",
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "rewarded.rules",
        "rewarded.provider-configs",
        "rewarded.watch-sessions",
        "rewarded.unlock-receipts",
        "rewarded.core"
      ],
      "requires": [
        "crud.contracts",
        "runtime.actions",
        "runtime.http",
        "rewarded.grant-policy",
        "runtime.resources"
      ],
      "applicationRequires": [
        "rewarded.grant-policy"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/RewardedResources.js",
            "export": "RewardedRulesFeature"
          },
          {
            "entrypoint": "src/server/RewardedResources.js",
            "export": "RewardedProviderConfigsFeature"
          },
          {
            "entrypoint": "src/server/RewardedResources.js",
            "export": "RewardedWatchSessionsFeature"
          },
          {
            "entrypoint": "src/server/RewardedResources.js",
            "export": "RewardedUnlockReceiptsFeature"
          },
          {
            "entrypoint": "src/server/RewardedCoreFeature.js",
            "export": "RewardedCoreFeature"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "jskit": {
        "tableOwnership": {
          "tables": [
            {
              "tableName": "rewarded_rules",
              "providerEntrypoint": "src/server/RewardedResources.js",
              "ownershipFilter": "workspace"
            },
            {
              "tableName": "rewarded_provider_configs",
              "providerEntrypoint": "src/server/RewardedResources.js",
              "ownershipFilter": "workspace"
            },
            {
              "tableName": "rewarded_watch_sessions",
              "providerEntrypoint": "src/server/RewardedResources.js",
              "ownershipFilter": "workspace_user"
            },
            {
              "tableName": "rewarded_unlock_receipts",
              "providerEntrypoint": "src/server/RewardedResources.js",
              "ownershipFilter": "workspace_user"
            }
          ]
        }
      },
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./shared",
            "summary": "Exports Rewarded shared CRUD resources."
          },
          {
            "subpath": "./server/rewardedActions",
            "summary": "Exports the Rewarded workflow action identifiers and createRewardedActions()."
          },
          {
            "subpath": "./server/requireRewardedUnlock",
            "summary": "Exports the server helper that enforces a rewarded unlock before a protected feature action continues."
          },
          {
            "subpath": "./server/types",
            "summary": "Types of the rewarded.core, rewarded.rules, rewarded.provider-configs, rewarded.watch-sessions and rewarded.unlock-receipts capabilities, for features that require them."
          }
        ],
        "capabilities": [
          "rewarded.rules",
          "rewarded.provider-configs",
          "rewarded.watch-sessions",
          "rewarded.unlock-receipts",
          "rewarded.core"
        ]
      }
    },
    "migrations": {
      "directories": [
        "migrations"
      ]
    }
  },
  "dependencies": {
    "@jskit-ai/crud-core": "0.2.34",
    "@jskit-ai/resource-core": "0.1.214",
    "@jskit-ai/resource-crud-core": "0.1.216",
    "@jskit-ai/users-core": "0.2.39",
    "@jskit-ai/workspaces-core": "0.2.39",
    "json-rest-schema": "^1.0.20"
  },
  "peerDependencies": {
    "@jskit-ai/auth-core": "0.2.24",
    "@jskit-ai/database-runtime": "0.1.272",
    "@jskit-ai/http-runtime": "0.2.23",
    "@jskit-ai/kernel": "0.2.23",
    "@jskit-ai/resource-runtime": "0.2.30"
  }
}
