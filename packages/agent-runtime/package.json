{
  "name": "@jskit-ai/agent-runtime",
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1"
  },
  "exports": {
    "./server": "./src/server/index.js",
    "./server/types": "./src/server/types.js"
  },
  "dependencies": {
    "@jskit-ai/agent": "0.1.1",
    "zod": "^4.6.7"
  },
  "description": "Opt-in parts of the agent: its own tables (saved runs, goals, summaries, commands) and coding tools (files, commands in gVisor or a local process, to-do list, notes, goals, asking the person). PostgreSQL.",
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [],
      "requires": []
    },
    "runtime": {
      "server": {
        "providers": []
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "jskit": {
        "tableOwnership": {
          "tables": [
            {
              "tableName": "agent_runs"
            },
            {
              "tableName": "agent_goals"
            },
            {
              "tableName": "agent_summaries"
            },
            {
              "tableName": "agent_summary_queue"
            },
            {
              "tableName": "agent_commands"
            }
          ]
        }
      },
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server",
            "summary": "Saved runs and their resumer, goal rounds, background summaries, planning notes, the default coding tools and their executors."
          },
          {
            "subpath": "./server/types",
            "summary": "Types of the runs, goals, commands, notices and executors the server parts build or receive, for code that receives them."
          }
        ],
        "capabilities": []
      }
    },
    "migrations": {
      "directories": [
        "migrations"
      ]
    }
  }
}
