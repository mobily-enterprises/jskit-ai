{
  "name": "@jskit-ai/assistant-runtime",
  "version": "0.1.138",
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    "./client": "./src/client/index.js",
    "./shared": "./src/shared/index.js",
    "./server/actionIds": "./src/server/actionIds.js"
  },
  "dependencies": {
    "@jskit-ai/assistant-core": "0.1.143",
    "@jskit-ai/database-runtime": "0.1.167",
    "@jskit-ai/http-web": "0.1.12",
    "@jskit-ai/http-runtime": "0.1.165",
    "@jskit-ai/kernel": "0.1.167",
    "@jskit-ai/shell-web": "0.1.171",
    "json-rest-schema": "^1.0.17"
  },
  "peerDependencies": {
    "@tanstack/vue-query": "^5.90.5",
    "vue": "^3.5.13",
    "vuetify": "^4.0.0"
  },
  "description": "Capability-based assistant runtime with per-surface chat, transcripts, settings, and action tools.",
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "assistant.runtime"
      ],
      "requires": [
        "runtime.actions",
        "runtime.config",
        "runtime.database",
        "runtime.env",
        "runtime.http",
        "runtime.http-web",
        "runtime.http-client"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/AssistantProvider.js",
            "export": "AssistantFeature"
          }
        ]
      },
      "client": {
        "providers": [
          {
            "entrypoint": "src/client/providers/AssistantClientProvider.js",
            "export": "AssistantClientProvider"
          }
        ]
      }
    },
    "metadata": {
      "jskit": {
        "tableOwnership": {
          "tables": [
            {
              "tableName": "assistant_config"
            },
            {
              "tableName": "assistant_conversations"
            },
            {
              "tableName": "assistant_messages"
            }
          ]
        }
      },
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./client",
            "summary": "Exports assistant runtime client elements and composables."
          },
          {
            "subpath": "./shared",
            "summary": "Exports assistant runtime shared config helpers."
          },
          {
            "subpath": "./server/actionIds",
            "summary": "Exports assistant runtime action identifiers."
          }
        ],
        "capabilities": [
          "assistant.runtime"
        ]
      }
    },
    "migrations": {
      "directories": [
        "migrations"
      ]
    }
  }
}
