{
  "name": "@jskit-ai/assistant-runtime",
  "version": "0.2.69",
  "type": "module",
  "scripts": {
    "test": "jskit test"
  },
  "exports": {
    "./client": "./src/client/index.js",
    "./client/providers/AssistantClientProvider": "./src/client/providers/AssistantClientProvider.js",
    "./shared": "./src/shared/index.js",
    "./server/actionIds": "./src/server/actionIds.js",
    "./server": "./src/server/index.js",
    "./server/types": "./src/server/types.js",
    "./locales/en.json": "./locales/en.json"
  },
  "dependencies": {
    "@jskit-ai/assistant-core": "0.2.65",
    "@jskit-ai/resource-core": "0.1.217",
    "json-rest-schema": "^1.0.20"
  },
  "peerDependencies": {
    "@jskit-ai/http-runtime": "0.2.26",
    "@jskit-ai/http-web": "0.2.44",
    "@jskit-ai/kernel": "0.2.26",
    "@jskit-ai/realtime": "0.2.40",
    "@jskit-ai/shell-web": "0.2.37",
    "@tanstack/vue-query": "^5.90.5",
    "vue": "^3.5.13",
    "vuetify": "^4.0.0",
    "@jskit-ai/database-runtime": "0.1.275",
    "@jskit-ai/resource-runtime": "0.2.36"
  },
  "description": "Capability-based assistant runtime with per-surface chat, transcripts, settings, and action tools.",
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "assistant.runtime"
      ],
      "requires": [
        "runtime.actions",
        "runtime.config",
        "runtime.env",
        "runtime.events",
        "runtime.http",
        "runtime.http-web",
        "runtime.logger"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/AssistantProvider.js",
            "export": "AssistantFeature"
          }
        ]
      },
      "client": {
        "providers": [
          {
            "entrypoint": "src/client/providers/AssistantClientProvider.js",
            "export": "AssistantClientProvider"
          }
        ]
      }
    },
    "metadata": {
      "jskit": {
        "tableOwnership": {
          "tables": [
            {
              "tableName": "assistant_config"
            },
            {
              "tableName": "assistant_conversations"
            },
            {
              "tableName": "assistant_messages"
            },
            {
              "tableName": "assistant_turn_requests"
            }
          ]
        }
      },
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./client",
            "summary": "Exports assistant runtime client elements and composables."
          },
          {
            "subpath": "./client/providers/AssistantClientProvider",
            "summary": "Exports the assistant client provider, which the client bootstrap loads without the elements."
          },
          {
            "subpath": "./shared",
            "summary": "Exports assistant runtime shared config helpers."
          },
          {
            "subpath": "./server/actionIds",
            "summary": "Exports assistant runtime action identifiers."
          },
          {
            "subpath": "./server",
            "summary": "Provides conversation routes, authorized shared realtime subscriptions, explicit Fastify hosting shorthand, optional database integration (AssistantStoreFeature owns its tables through runtime.resources and provides assistant.repositories), the per-surface assistant tool catalogue and the person-context prompt a host composes into its conversations' instructions."
          },
          {
            "subpath": "./server/types",
            "summary": "Type of the assistant.runtime capability, and the contracts of the optional capabilities it reads."
          }
        ],
        "capabilities": [
          "assistant.runtime"
        ]
      },
      "client": {
        "singleton": true
      }
    },
    "migrations": {
      "directories": [
        "migrations"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@jskit-ai/realtime": {
      "optional": true
    },
    "@jskit-ai/database-runtime": {
      "optional": true
    },
    "@jskit-ai/resource-runtime": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jskit-ai/material-web": "0.1.8",
    "@jskit-ai/resource-runtime": "0.2.36"
  }
}
