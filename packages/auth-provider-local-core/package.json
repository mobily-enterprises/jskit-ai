{
  "name": "@jskit-ai/auth-provider-local-core",
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1"
  },
  "exports": {
    "./server/providers/AuthLocalProvider": "./src/server/providers/AuthLocalProvider.js",
    "./server/lib/index": "./src/server/lib/index.js",
    "./locales/en.json": "./locales/en.json"
  },
  "dependencies": {
    "openid-client": "6.8.8"
  },
  "description": "Local auth provider with a file backend default, no database requirement, and optional Google, Microsoft and GitHub sign-in.",
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "auth.service"
      ],
      "requires": [
        "auth.extensions",
        "runtime.app-root",
        "runtime.env",
        "runtime.logger"
      ]
    },
    "runtime": {
      "server": {
        "providerEntrypoint": "src/server/providers/AuthLocalProvider.js",
        "providers": [
          {
            "entrypoint": "src/server/providers/AuthLocalProvider.js",
            "export": "AuthLocalProvider"
          }
        ]
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/providers/AuthLocalProvider",
            "summary": "Provides the selected local authentication service through explicit runtime capabilities."
          },
          {
            "subpath": "./server/lib/index",
            "summary": "Exports local auth service, file backend helpers, password strategy helpers, and local auth register hook decorators. Google, Microsoft and GitHub sign-in turn on from AUTH_GOOGLE_*, AUTH_MICROSOFT_* and AUTH_GITHUB_* client id and secret pairs."
          }
        ],
        "extensionCapabilities": [
          "auth.invitation-context",
          "auth.local.backend",
          "auth.local.password-strategy",
          "auth.profile.projector",
          "auth.local.recovery-sender"
        ]
      }
    }
  },
  "peerDependencies": {
    "@jskit-ai/auth-core": "0.2.1",
    "@jskit-ai/kernel": "0.2.1"
  }
}
