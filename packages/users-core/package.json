{
  "name": "@jskit-ai/users-core",
  "version": "0.2.25",
  "type": "module",
  "scripts": {
    "test": "jskit test"
  },
  "exports": {
    "./server/UsersFeature": "./src/server/UsersFeature.js",
    "./server/UsersIdentityProvider": "./src/server/UsersIdentityProvider.js",
    "./server/usersExtensions": "./src/server/usersExtensions.js",
    "./server/resolveActionUser": "./src/server/common/support/resolveActionUser.js",
    "./server/types": "./src/server/types.js",
    "./shared/resources/userProfileResource": "./src/shared/resources/userProfileResource.js",
    "./shared/resources/userSettingsResource": "./src/shared/resources/userSettingsResource.js",
    "./shared/settings": "./src/shared/settings.js",
    "./server/UsersExtensionsProvider": "./src/server/UsersExtensionsProvider.js",
    "./locales/en.json": "./locales/en.json"
  },
  "dependencies": {
    "@jskit-ai/resource-core": "0.1.209",
    "@jskit-ai/resource-crud-core": "0.1.210",
    "@jskit-ai/storage-runtime": "0.1.264",
    "@jskit-ai/uploads-runtime": "0.2.18",
    "json-rest-schema": "^1.0.20"
  },
  "description": "Users/account runtime plus HTTP routes for account features.",
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "users.core",
        "users.profiles",
        "users.settings",
        "users.extensions",
        "auth.profile.projector"
      ],
      "requires": [
        "auth.service",
        "runtime.actions",
        "runtime.bootstrap",
        "runtime.database",
        "runtime.http",
        "runtime.resources",
        "runtime.storage",
        "runtime.uploads"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/UsersExtensionsProvider.js",
            "export": "UsersExtensionsProvider"
          },
          {
            "entrypoint": "src/server/UsersIdentityProvider.js",
            "export": "UsersIdentityProvider"
          },
          {
            "entrypoint": "src/server/UsersFeature.js",
            "export": "UsersFeature"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "jskit": {
        "tableOwnership": {
          "tables": [
            {
              "tableName": "user_settings"
            }
          ]
        }
      },
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/UsersFeature",
            "summary": "Exports UsersFeature, which provides users.core: the account settings, profile, avatar and security services, their actions and routes, and the users bootstrap."
          },
          {
            "subpath": "./server/UsersIdentityProvider",
            "summary": "Exports UsersIdentityProvider, which provides users.profiles (the users table's records, with createWithSettings and countUsers), users.settings (the users' settings records) and auth.profile.projector."
          },
          {
            "subpath": "./server/usersExtensions",
            "summary": "Exports createUsersExtensions, the users.extensions registry of profile synchronization lifecycle contributors."
          },
          {
            "subpath": "./server/resolveActionUser",
            "summary": "Exports resolveActionUser, which reads an action's signed-in user."
          },
          {
            "subpath": "./shared/resources/userProfileResource",
            "summary": "Exports the users table resource (userProfileTableResource), the account profile's CRUD contract (userProfileCrud) and the profile API contract (userProfileContract)."
          },
          {
            "subpath": "./shared/resources/userSettingsResource",
            "summary": "Exports the user_settings table resource (userSettingsTableResource), the account settings' CRUD contract (userSettingsCrud), the settings API contract (userSettingsContract) and the settings keys and output schemas."
          },
          {
            "subpath": "./shared/settings",
            "summary": "Exports the users settings defaults."
          },
          {
            "subpath": "./server/types",
            "summary": "Types of the users.core, users.profiles, users.settings and users.extensions capabilities, for features that require them."
          },
          {
            "subpath": "./server/UsersExtensionsProvider",
            "summary": "Exports UsersExtensionsProvider, which provides users.extensions, for a test that starts UsersIdentityProvider."
          }
        ],
        "capabilities": [
          "users.core",
          "users.profiles",
          "users.settings",
          "users.extensions",
          "auth.profile.projector"
        ]
      },
      "server": {
        "routes": [
          {
            "method": "GET",
            "path": "/api/settings",
            "summary": "Get authenticated user settings."
          },
          {
            "method": "PATCH",
            "path": "/api/settings/profile",
            "summary": "Update profile settings."
          },
          {
            "method": "GET",
            "path": "/api/settings/profile/avatar",
            "summary": "Read authenticated user's uploaded avatar."
          },
          {
            "method": "POST",
            "path": "/api/settings/profile/avatar",
            "summary": "Upload profile avatar."
          },
          {
            "method": "DELETE",
            "path": "/api/settings/profile/avatar",
            "summary": "Delete profile avatar."
          },
          {
            "method": "PATCH",
            "path": "/api/settings/preferences",
            "summary": "Update user preferences."
          },
          {
            "method": "PATCH",
            "path": "/api/settings/notifications",
            "summary": "Update notification settings."
          },
          {
            "method": "POST",
            "path": "/api/settings/security/change-password",
            "summary": "Set or change password for authenticated user."
          },
          {
            "method": "PATCH",
            "path": "/api/settings/security/methods/password",
            "summary": "Enable or disable password sign-in method."
          },
          {
            "method": "GET",
            "path": "/api/settings/security/oauth/:provider/start",
            "summary": "Start linking an OAuth provider for authenticated user."
          },
          {
            "method": "DELETE",
            "path": "/api/settings/security/oauth/:provider",
            "summary": "Unlink an OAuth provider from authenticated account."
          },
          {
            "method": "POST",
            "path": "/api/settings/security/logout-others",
            "summary": "Sign out from other active sessions."
          }
        ]
      }
    },
    "migrations": {
      "directories": [
        "migrations"
      ]
    }
  },
  "peerDependencies": {
    "@jskit-ai/auth-core": "0.2.18",
    "@jskit-ai/database-runtime": "0.1.267",
    "@jskit-ai/http-runtime": "0.2.18",
    "@jskit-ai/kernel": "0.2.18",
    "@jskit-ai/resource-runtime": "0.2.21"
  }
}
