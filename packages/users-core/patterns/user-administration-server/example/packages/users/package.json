{
  "name": "@app/users",
  "version": "0.0.0",
  "description": "App-local read-only user administration feature.",
  "private": true,
  "type": "module",
  "exports": {
    "./server/UsersFeature": "./src/server/UsersFeature.js",
    "./server/types": "./src/server/types.js",
    "./shared": "./src/shared/index.js"
  },
  "dependencies": {
    "@jskit-ai/crud-core": "0.2.12",
    "@jskit-ai/resource-core": "0.1.202",
    "@jskit-ai/resource-crud-core": "0.1.202"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "app.users"
      ],
      "requires": [
        "runtime.http",
        "runtime.json-rest-api",
        "runtime.actions",
        "runtime.database"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/UsersFeature.js",
            "export": "UsersFeature"
          }
        ]
      },
      "client": {
        "providers": []
      }
    }
  }
}
