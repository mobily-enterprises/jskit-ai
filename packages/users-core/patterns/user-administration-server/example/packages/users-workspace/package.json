{
  "name": "@app/users-workspace",
  "version": "0.0.0",
  "description": "App-local workspace-scoped read-only user administration feature.",
  "private": true,
  "type": "module",
  "exports": {
    "./server/UsersWorkspaceFeature": "./src/server/UsersWorkspaceFeature.js",
    "./server/types": "./src/server/types.js",
    "./shared": "./src/shared/index.js"
  },
  "dependencies": {
    "@jskit-ai/crud-core": "0.2.26",
    "@jskit-ai/resource-crud-core": "0.1.211",
    "@jskit-ai/users-core": "0.2.27",
    "@jskit-ai/workspaces-core": "0.2.27"
  },
  "peerDependencies": {
    "@jskit-ai/kernel": "0.2.18",
    "@jskit-ai/resource-runtime": "0.2.23"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "app.users-workspace"
      ],
      "requires": [
        "crud.contracts",
        "runtime.http",
        "runtime.actions",
        "users.profiles",
        "workspaces.memberships"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/UsersWorkspaceFeature.js",
            "export": "UsersWorkspaceFeature"
          }
        ]
      },
      "client": {
        "providers": []
      }
    }
  }
}
