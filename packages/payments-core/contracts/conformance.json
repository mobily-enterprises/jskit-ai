  "accountScenario": {
    "document": {
      "integrations": {
        "billing": {
          "provider": "stripe",
          "accountMode": "shared",
          "authentication": {
            "method": "api-key",
            "secretRef": "env:STRIPE_KEY"
          }
        }
      },
      "extensions": {
        "payments": {
          "version": 1,
          "environments": {
            "sandbox": {
              "integrationId": "billing",
              "providerAccountId": "acct_fixture",
              "webhookSecretRef": "env:STRIPE_WEBHOOK_SECRET",
              "returnUrlRef": "env:BILLING_RETURN_URL"
            }
          },
          "plans": {
            "pro": {
              "name": "Pro",
              "amount": 1200,
              "currency": "USD",
              "interval": "month",
              "features": [
                "export"
              ],
              "renewalCredits": 100
            }
          }
        }
      }
    },
    "scope": {
      "applicationId": "app-fixture",
      "integrationId": "billing",
      "providerAccountId": "acct_fixture",
      "environment": "sandbox",
      "subjectId": "tenant-a"
    },
    "clock": 1000,
    "customerId": "customer-fixture",
    "steps": [
      {
        "operation": "inspect",
        "expect": {
          "balance": 0,
          "features": [],
          "subscriptions": []
        }
      },
      {
        "operation": "reconcileEvent",
        "input": {
          "eventId": "event-one",
          "customerId": "customer-fixture"
        },
        "facts": {
          "subscription": {
            "id": "sub_fixture",
            "status": "active",
            "planId": "pro",
            "periodEnd": 5000
          },
          "renewal": {
            "id": "invoice_fixture",
            "planId": "pro",
            "periodEnd": 5000
          }
        },
        "expect": {
          "duplicate": false,
          "subscriptionId": "sub_fixture"
        }
      },
      {
        "operation": "inspect",
        "expect": {
          "balance": 100,
          "features": [
            "export"
          ],
          "subscriptions": [
            {
              "id": "sub_fixture",
              "status": "active",
              "planId": "pro",
              "periodEnd": 5000
            }
          ]
        }
      },
      {
        "operation": "reconcileEvent",
        "input": {
          "eventId": "event-one",
          "customerId": "customer-fixture"
        },
        "facts": {
          "subscription": {
            "id": "sub_fixture",
            "status": "active",
            "planId": "pro",
            "periodEnd": 5000
          },
          "renewal": {
            "id": "invoice_fixture",
            "planId": "pro",
            "periodEnd": 5000
          }
        },
        "expect": {
          "duplicate": true
        }
      },
      {
        "operation": "reconcileEvent",
        "input": {
          "eventId": "event-two",
          "customerId": "customer-fixture"
        },
        "facts": {
          "subscription": {
            "id": "sub_fixture",
            "status": "active",
            "planId": "pro",
            "periodEnd": 5000
          },
          "renewal": {
            "id": "invoice_fixture",
            "planId": "pro",
            "periodEnd": 5000
          }
        },
        "expect": {
          "duplicate": false,
          "creditGrant": {
            "duplicate": true,
            "granted": 100,
            "expiresAt": 5000
          }
        }
      },
      {
        "operation": "debitCredits",
        "input": {
          "reference": "export-one",
          "units": 30
        },
        "expect": {
          "duplicate": false,
          "debited": 30
        }
      },
      {
        "operation": "debitCredits",
        "input": {
          "reference": "export-one",
          "units": 30
        },
        "expect": {
          "duplicate": true,
          "debited": 30
        }
      },
      {
        "operation": "debitCredits",
        "input": {
          "reference": "export-one",
          "units": 31
        },
        "error": "payment_reference_conflict"
      },
      {
        "operation": "inspect",
        "expect": {
          "balance": 70,
          "features": [
            "export"
          ]
        }
      },
      {
        "operation": "inspect",
        "subjectId": "tenant-b",
        "expect": {
          "balance": 0,
          "features": [],
          "subscriptions": []
        }
      },
      {
        "operation": "inspect",
        "clock": 5000,
        "expect": {
          "balance": 0,
          "features": []
        }
      },
      {
        "operation": "refundDebit",
        "input": {
          "debitReference": "export-one"
        },
        "expect": {
          "restored": 0,
          "expired": 30,
          "duplicate": false
        }
      },
      {
        "operation": "grantCredits",
        "input": {
          "reference": "promotion-one",
          "units": 20,
          "expiresAt": null
        },
        "expect": {
          "granted": 20,
          "expiresAt": null,
          "duplicate": false
        }
      },
      {
        "operation": "debitCredits",
        "input": {
          "reference": "too-large",
          "units": 21
        },
        "error": "payment_insufficient_credits"
      },
      {
        "operation": "inspect",
        "expect": {
          "balance": 20,
          "features": []
        }
      }
    ]
  }
