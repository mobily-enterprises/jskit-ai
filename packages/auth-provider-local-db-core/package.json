{
  "name": "@jskit-ai/auth-provider-local-db-core",
  "version": "0.1.179",
  "type": "module",
  "scripts": {
    "test": "jskit test"
  },
  "exports": {
    "./server/providers/AuthLocalDatabaseBackendProvider": "./src/server/providers/AuthLocalDatabaseBackendProvider.js",
    "./server/lib/index": "./src/server/lib/index.js",
    "./server/types": "./src/server/types.js"
  },
  "dependencies": {
    "@jskit-ai/auth-provider-local-core": "0.2.30",
    "@jskit-ai/resource-core": "0.1.215"
  },
  "peerDependencies": {
    "@jskit-ai/auth-core": "0.2.25",
    "@jskit-ai/database-runtime": "0.1.273",
    "@jskit-ai/kernel": "0.2.24",
    "@jskit-ai/resource-runtime": "0.2.31"
  },
  "description": "Database-backed local auth storage backend for JSKIT local auth.",
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "auth.local.backend",
        "auth.local.accounts",
        "auth.local.sessions",
        "auth.local.recovery"
      ],
      "requires": [
        "runtime.database",
        "runtime.resources"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/providers/AuthLocalDatabaseBackendProvider.js",
            "export": "AuthLocalDatabaseBackendProvider"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "jskit": {
        "tableOwnership": {
          "tables": [
            {
              "tableName": "auth_local_users"
            },
            {
              "tableName": "auth_local_sessions"
            },
            {
              "tableName": "auth_local_recovery"
            },
            {
              "tableName": "auth_local_identities"
            },
            {
              "tableName": "auth_local_oauth_attempts"
            },
            {
              "tableName": "auth_local_sign_in_failures"
            },
            {
              "tableName": "auth_local_registrations"
            },
            {
              "tableName": "auth_local_second_factors"
            }
          ]
        }
      },
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/providers/AuthLocalDatabaseBackendProvider",
            "summary": "Provides the database-backed local authentication repository contract (auth.local.backend) and the owner APIs of its accounts, sessions and recovery tokens (auth.local.accounts, auth.local.sessions, auth.local.recovery)."
          },
          {
            "subpath": "./server/lib/index",
            "summary": "Exports the DB local auth backend and owner API factories."
          },
          {
            "subpath": "./server/types",
            "summary": "Types of the auth.local.accounts, auth.local.sessions and auth.local.recovery capabilities, for features that require them."
          }
        ],
        "capabilities": [
          "auth.local.backend",
          "auth.local.accounts",
          "auth.local.sessions",
          "auth.local.recovery"
        ]
      }
    },
    "migrations": {
      "directories": [
        "migrations"
      ]
    }
  }
}
