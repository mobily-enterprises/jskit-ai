{
  "name": "@jskit-ai/rewarded-web",
  "version": "0.2.40",
  "type": "module",
  "scripts": {
    "test": "jskit test"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client/index.js",
    "./client/types": "./src/client/types.js",
    "./server": "./src/server/index.js",
    "./shared": "./src/shared/index.js",
    "./locales/en.json": "./locales/en.json"
  },
  "description": "Rewarded gate client workflow with explicitly composed application delivery.",
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "rewarded.web"
      ],
      "requires": [
        "client.vue",
        "client.rewarded-delivery"
      ],
      "applicationRequires": [
        "client.rewarded-delivery"
      ]
    },
    "runtime": {
      "server": {
        "providers": []
      },
      "client": {
        "providers": [
          {
            "entrypoint": "src/client/providers/RewardedClientProvider.js",
            "export": "RewardedClientProvider"
          }
        ]
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./client",
            "summary": "Exports the Rewarded client provider, runtime composable, and fullscreen gate host."
          },
          {
            "subpath": "./client/types",
            "summary": "The delivery contract an application supplies and the runtime it receives, as JSDoc types."
          }
        ]
      },
      "client": {
        "singleton": true
      }
    }
  },
  "dependencies": {
    "@jskit-ai/rewarded-core": "0.2.34"
  },
  "peerDependencies": {
    "@jskit-ai/http-runtime": "0.2.21",
    "@jskit-ai/kernel": "0.2.21",
    "@jskit-ai/shell-web": "0.2.30",
    "vue": "^3.5.13"
  }
}
