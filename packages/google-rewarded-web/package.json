{
  "name": "@jskit-ai/google-rewarded-web",
  "version": "0.1.107",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client/index.js",
    "./server": "./src/server/index.js",
    "./shared": "./src/shared/index.js"
  },
  "description": "Google rewarded client runtime with a fullscreen gate host and GPT orchestration.",
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "google-rewarded.web"
      ],
      "requires": []
    },
    "runtime": {
      "server": {
        "providers": []
      },
      "client": {
        "providers": [
          {
            "entrypoint": "src/client/providers/GoogleRewardedClientProvider.js",
            "export": "GoogleRewardedClientProvider"
          }
        ]
      }
    },
    "metadata": {
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./client",
            "summary": "Exports the Google rewarded client provider, runtime composable, and fullscreen gate host."
          }
        ]
      },
      "client": {
        "singleton": true
      }
    }
  },
  "dependencies": {
    "@jskit-ai/google-rewarded-core": "0.1.107"
  },
  "peerDependencies": {
    "@jskit-ai/http-runtime": "0.1.169",
    "@jskit-ai/kernel": "0.1.171",
    "@jskit-ai/shell-web": "0.1.175"
  }
}
