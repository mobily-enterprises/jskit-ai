{
  "name": "@jskit-ai/console-core",
  "version": "0.2.25",
  "type": "module",
  "scripts": {
    "test": "jskit test"
  },
  "exports": {
    "./server/ConsoleFeature": "./src/server/ConsoleFeature.js",
    "./server/types": "./src/server/types.js",
    "./shared/resources/consoleSettingsResource": "./src/shared/resources/consoleSettingsResource.js",
    "./locales/en.json": "./locales/en.json"
  },
  "dependencies": {
    "@jskit-ai/resource-core": "0.1.209",
    "@jskit-ai/users-core": "0.2.25",
    "json-rest-schema": "^1.0.20"
  },
  "description": "Console runtime: console settings schema, bootstrap flags, actions, and HTTP routes.",
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "console.core",
        "console.settings"
      ],
      "requires": [
        "auth.extensions",
        "runtime.actions",
        "runtime.bootstrap",
        "runtime.http",
        "runtime.resources"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/ConsoleFeature.js",
            "export": "ConsoleFeature"
          }
        ]
      },
      "client": {
        "providers": []
      }
    },
    "metadata": {
      "jskit": {
        "tableOwnership": {
          "tables": [
            {
              "tableName": "console_settings"
            }
          ]
        }
      },
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/ConsoleFeature",
            "summary": "Exports ConsoleFeature, which provides console.core (owner access, the console settings actions and routes, and the console bootstrap) and console.settings (the console's settings record, read with getSingleton)."
          },
          {
            "subpath": "./shared/resources/consoleSettingsResource",
            "summary": "Exports the shared console settings resource contract."
          },
          {
            "subpath": "./server/types",
            "summary": "Types of the console.core and console.settings capabilities, for features that require them."
          }
        ],
        "capabilities": [
          "console.core",
          "console.settings"
        ]
      },
      "server": {
        "routes": [
          {
            "method": "GET",
            "path": "/api/console/settings",
            "summary": "Get console settings."
          },
          {
            "method": "PATCH",
            "path": "/api/console/settings",
            "summary": "Update console settings."
          }
        ]
      }
    },
    "migrations": {
      "directories": [
        "migrations"
      ]
    }
  },
  "peerDependencies": {
    "@jskit-ai/auth-core": "0.2.18",
    "@jskit-ai/database-runtime": "0.1.267",
    "@jskit-ai/http-runtime": "0.2.18",
    "@jskit-ai/kernel": "0.2.18",
    "@jskit-ai/resource-runtime": "0.2.21"
  }
}
