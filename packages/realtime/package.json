{
  "name": "@jskit-ai/realtime",
  "version": "0.2.32",
  "type": "module",
  "scripts": {
    "test": "jskit test"
  },
  "exports": {
    "./server/RealtimeProvider": "./src/server/RealtimeProvider.js",
    "./server/RealtimeAudienceScopeFeature": "./src/server/RealtimeAudienceScopeFeature.js",
    "./server/runtime": "./src/server/runtime.js",
    "./server/types": "./src/server/types.js",
    "./client": "./src/client/RealtimeClientProvider.js",
    "./client/RealtimeClientProvider": "./src/client/RealtimeClientProvider.js",
    "./client/composables/useRealtimeEvent": "./src/client/composables/useRealtimeEvent.js",
    "./client/runtime": "./src/client/runtime.js",
    "./client/types": "./src/client/types.js",
    "./locales/en.json": "./locales/en.json"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "redis": "^5.8.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "peerDependencies": {
    "@jskit-ai/kernel": "0.2.21",
    "vue": "^3.5.13"
  },
  "description": "Thin, generic realtime runtime wrappers for socket.io server and client.",
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "runtime.realtime",
        "client.realtime"
      ],
      "requires": [
        "runtime.config",
        "runtime.env",
        "runtime.events",
        "runtime.fastify",
        "runtime.logger"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/RealtimeProvider.js",
            "export": "RealtimeProvider"
          }
        ]
      },
      "client": {
        "providers": [
          {
            "entrypoint": "src/client/RealtimeClientProvider.js",
            "export": "RealtimeClientProvider"
          }
        ]
      }
    },
    "metadata": {
      "client": {
        "optimizeDeps": {
          "include": [
            "socket.io-client"
          ]
        },
        "singleton": true
      },
      "apiSummary": {
        "surfaces": [
          {
            "subpath": "./server/RealtimeProvider",
            "summary": "Exports the explicit RealtimeProvider capability provider."
          },
          {
            "subpath": "./server/RealtimeAudienceScopeFeature",
            "summary": "Exports RealtimeAudienceScopeFeature, which provides realtime.audience-scope: the contexts scoped to an event's workspace, user or workspace user that an audience's audienceUsers reads in. Applications whose audiences read owned tables register it."
          },
          {
            "subpath": "./server/runtime",
            "summary": "Exports the Socket.IO server and Redis adapter runtime helpers."
          },
          {
            "subpath": "./client",
            "summary": "Exports RealtimeClientProvider and resolveRealtimeClientConfig."
          },
          {
            "subpath": "./client/RealtimeClientProvider",
            "summary": "Exports RealtimeClientProvider and resolveRealtimeClientConfig."
          },
          {
            "subpath": "./client/composables/useRealtimeEvent",
            "summary": "Exports useRealtimeEvent, useRealtimeSocket, REALTIME_SOCKET_KEY and NO_REALTIME_SOCKET; listeners are owned by their Vue effect scope."
          },
          {
            "subpath": "./client/runtime",
            "summary": "Exports createSocketIoClient, disconnectSocketIoClient and reconnectSocketIoClient."
          },
          {
            "subpath": "./client/types",
            "summary": "Types of the application's socket, useRealtimeEvent's options and the client.realtime capability."
          },
          {
            "subpath": "./locales/en.json",
            "summary": "English catalog for the realtime connection indicator, registered by the generated client bootstrap."
          },
          {
            "subpath": "./server/types",
            "summary": "Type of the runtime.realtime capability, for features that require it."
          }
        ],
        "capabilities": {
          "server": [
            "runtime.realtime"
          ],
          "client": [
            "client.realtime"
          ]
        }
      },
      "ui": {
        "placements": {
          "outlets": [],
          "contributions": [
            {
              "id": "realtime.connection.indicator",
              "target": "shell.status",
              "kind": "component",
              "surfaces": [
                "*"
              ],
              "order": 950,
              "componentToken": "realtime.web.connection.indicator",
              "source": "patterns/realtime-application/example/src/placement.js"
            }
          ]
        }
      }
    },
    "vite": {
      "proxy": {
        "/socket.io": {
          "changeOrigin": true,
          "ws": true
        }
      }
    }
  }
}
