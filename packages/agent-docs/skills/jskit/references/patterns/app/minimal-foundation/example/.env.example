# Where this app runs: development, test, staging or production (the JSKIT Environments guide).
# `npm run develop`, `npm run dev` and `jskit test` set it themselves; `npm start` reads it here or from the host.
# Staging and production also need NODE_ENV=production.
APP_ENV=development

# Staging only: the one address every email goes to, and the one number every SMS goes to. Unset, each is logged.
# STAGING_EMAIL_TO=
# STAGING_SMS_TO=
