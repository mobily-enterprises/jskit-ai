{
  "name": "@app/books",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./server/BooksFeature": "./src/server/BooksFeature.js",
    "./server/types": "./src/server/types.js",
    "./shared": "./src/shared/index.js"
  },
  "dependencies": {
    "@jskit-ai/crud-core": "0.2.22",
    "@jskit-ai/resource-core": "0.1.208",
    "@jskit-ai/resource-crud-core": "0.1.208"
  },
  "jskit": {
    "kind": "runtime",
    "capabilities": {
      "provides": [
        "app.books"
      ],
      "requires": [
        "crud.contracts",
        "runtime.http",
        "runtime.actions",
        "runtime.resources"
      ]
    },
    "runtime": {
      "server": {
        "providers": [
          {
            "entrypoint": "src/server/BooksFeature.js",
            "export": "BooksFeature"
          }
        ]
      },
      "client": {
        "providers": []
      }
    }
  }
}
