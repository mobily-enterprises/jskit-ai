{
  "name": "jskit-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "app:create": "node ./tooling/create-app/bin/jskit-create-app.js",
    "app:create:interactive": "node ./tooling/create-app/bin/jskit-create-app.js --interactive",
    "lint": "eslint packages tooling scripts --max-warnings=0",
    "check:runtime-deps": "node ./scripts/check-runtime-dependencies.mjs",
    "verify": "npm run lint && npm run test:release-npm && npm run check:runtime-deps && npm run jskit -- lint-packages && npm run generated:check && npm --workspaces --if-present test",
    "verify:registry": "npm run security:audit && npm --workspaces --if-present run test:registry",
    "check:di-labels": "npm run jskit -- lint-packages --check-di-labels",
    "jskit": "node ./tooling/jskit-cli/bin/jskit.js",
    "release": "npm run release:npm:prepare && npm run verify && npm run release:npm:publish",
    "catalog:build": "npm run --workspace tooling/jskit-catalog catalog:build",
    "cloc:actual": "cloc --vcs=git --include-ext=js,cjs,mjs,jsx,ts,tsx,vue,py,go,rs,java,kt,swift,rb,php,cs,cpp,c,h,sql,sh,bash,zsh,ps1,rst,adoc,txt --exclude-dir=node_modules,dist,build,coverage,.next,.nuxt,.turbo,.cache,storybook-static,vendor,tmp,temp,.output,.vercel .",
    "sloc:actual": "npm run cloc:actual",
    "docs:dev": "vitepress dev packages/agent-docs/site",
    "docs:build": "vitepress build packages/agent-docs/site",
    "docs:preview": "vitepress preview packages/agent-docs/site",
    "agent-docs:build": "node ./scripts/build-agent-docs.mjs",
    "generated:refs:check": "node ./scripts/check-generated-reference-paths.mjs",
    "generated:check": "node ./scripts/check-generated-files.mjs",
    "test:release-npm": "node --test ./scripts/release-npm.test.mjs",
    "security:audit": "npm audit --audit-level=low",
    "files:checklist": "./scripts/files-checklist.sh",
    "release:npm:prepare": "node ./scripts/release-npm.mjs prepare",
    "release:npm:prepare:dry-run": "node ./scripts/release-npm.mjs prepare --dry-run",
    "release:npm:publish": "node ./scripts/release-npm.mjs publish",
    "release:npm:publish:dry-run": "node ./scripts/release-npm.mjs publish --dry-run"
  },
  "workspaces": [
    "packages/*",
    "packages/*/*",
    "tooling/*"
  ],
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tanstack/vue-query": "^5.90.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "cloc": "^2.6.0-cloc",
    "jscpd": "^4.0.8",
    "knex": "^3.1.0",
    "pinia": "^3.0.4",
    "vite": "^8.2.1",
    "vitepress": "^1.6.4",
    "vue": "^3.5.13",
    "vue-router": "^5.0.4"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@jskit-ai/auth-core": "0.1.157",
    "@jskit-ai/auth-provider-supabase-core": "0.1.156",
    "@jskit-ai/auth-web": "0.1.159",
    "@jskit-ai/http-runtime": "0.1.157",
    "@jskit-ai/kernel": "0.1.159",
    "@mdi/js": "^7.4.47",
    "@supabase/supabase-js": "^2.57.4",
    "dotenv": "^17.3.1",
    "jose": "^6.1.0",
    "vuetify": "^4.0.0"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.3"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "vue-demi@0.14.10": true
  }
}
