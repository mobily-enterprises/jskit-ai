{
  "name": "jskit-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "lint": "eslint packages tooling scripts --max-warnings=0",
    "lint:packages": "node ./tooling/jskit-catalog/scripts/verify-packages.mjs",
    "check:runtime-deps": "node --test --test-concurrency=1 ./scripts/check-runtime-dependencies.test.mjs && node ./scripts/check-runtime-dependencies.mjs",
    "check:ci": "node --test --test-concurrency=1 ./scripts/check-ci-contract.test.mjs && node ./scripts/check-ci-contract.mjs",
    "verify": "npm run lint && npm run check:runtime-deps && npm run check:ci && npm run lint:packages && npm run generated:check && npm --workspaces --if-present test",
    "verify:registry": "npm run security:audit && npm --workspaces --if-present run test:registry",
    "release": "npm run verify && npm run npm-publish",
    "catalog:build": "npm run --workspace tooling/jskit-catalog catalog:build",
    "cloc:actual": "cloc --vcs=git --include-ext=js,cjs,mjs,jsx,ts,tsx,vue,py,go,rs,java,kt,swift,rb,php,cs,cpp,c,h,sql,sh,bash,zsh,ps1,rst,adoc,txt --exclude-dir=node_modules,dist,build,coverage,.next,.nuxt,.turbo,.cache,storybook-static,vendor,tmp,temp,.output,.vercel .",
    "sloc:actual": "npm run cloc:actual",
    "docs:dev": "vitepress dev packages/agent-docs/site",
    "docs:build": "vitepress build packages/agent-docs/site",
    "docs:preview": "vitepress preview packages/agent-docs/site",
    "agent-docs:build": "node ./scripts/build-agent-docs.mjs",
    "generated:refs:check": "node ./scripts/check-generated-reference-paths.mjs",
    "generated:check": "node ./scripts/check-generated-files.mjs",
    "test:release-npm": "node --test --test-concurrency=1 ./tooling/jskit-release/test/release.test.mjs",
    "security:audit": "npm audit --audit-level=low",
    "files:checklist": "./scripts/files-checklist.sh",
    "npm-publish": "jskit-release publish",
    "npm-publish:dry-run": "jskit-release publish --dry-run",
    "release:prepare": "jskit-release prepare",
    "release:prepare:dry-run": "jskit-release prepare --dry-run"
  },
  "jskitRelease": {
    "prepare": "node ./scripts/check-generated-files.mjs --regenerate",
    "nestedManifests": [
      "patterns",
      "examples"
    ]
  },
  "workspaces": [
    "packages/*",
    "packages/*/*",
    "tooling/*"
  ],
  "devDependencies": {
    "@fastify/fast-json-stringify-compiler": "^5.1.0",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@intlify/message-compiler": "^11.4.16",
    "@playwright/test": "1.61.1",
    "@tanstack/vue-query": "^5.90.5",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/devtools-api": "^8.2.1",
    "better-sqlite3": "13.0.3",
    "cloc": "^2.6.0-cloc",
    "fastify": "5.12.7",
    "jscpd": "^5.4.0",
    "knex": "^3.1.0",
    "pinia": "^4.0.3",
    "tar": "7.5.22",
    "vite": "^8.2.4",
    "vitepress": "^1.6.4",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.3.1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/csrf-protection": "^8.0.1",
    "@fastify/rate-limit": "^11.2.0",
    "@jskit-ai/auth-core": "0.2.1",
    "@jskit-ai/auth-provider-supabase-core": "0.2.2",
    "@jskit-ai/auth-web": "0.2.1",
    "@jskit-ai/http-runtime": "0.2.1",
    "@jskit-ai/kernel": "0.2.1",
    "@mdi/js": "^7.4.47",
    "@supabase/supabase-js": "^2.57.4",
    "dotenv": "^17.3.1",
    "jose": "^6.1.0",
    "vuetify": "^4.0.0"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.4"
    }
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": false,
    "esbuild@0.25.12": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "vue-demi@0.14.10": true
  }
}
